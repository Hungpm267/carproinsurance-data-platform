table etl_execution_log
	lineageTag: 5a8dfba4-ca96-4b33-a99b-a7648564ab10
	sourceLineageTag: [meta].[etl_execution_log]

	measure 'Tables Running' =
			
			CALCULATE(
			    COUNTROWS('etl_execution_log'),
			    'etl_execution_log'[controller_id] <> 0,
			    'etl_execution_log'[status] = "Running"
			)
		formatString: 0
		lineageTag: bb1ea1ff-adab-4d56-a900-5d471041a6ae

		changedProperty = Name

		changedProperty = IsHidden

	measure 'Success Rate %' =
			
			DIVIDE(
			    [Pipelines Success],
			    [Pipelines Success] + [Pipelines Failed],
			    0
			)
		lineageTag: 001c3664-0da9-4944-b1a3-30e1edb4249d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tables Failed' =
			
			CALCULATE(
			    COUNTROWS('etl_execution_log'),
			    'etl_execution_log'[controller_id] <> 0,
			    'etl_execution_log'[status] = "Failed"
			)
		formatString: 0
		lineageTag: a46c39ae-6b1d-4c38-a27a-5b453092a4ba

		changedProperty = Name

	measure 'Total Rows Inserted' = SUM('etl_execution_log'[rows_inserted])
		formatString: 0
		lineageTag: 679857e1-4ef7-4989-9fe3-dffbf22b28fb

		changedProperty = Name

	measure 'Total Rows Rejected' = SUM('etl_execution_log'[rows_rejected])
		formatString: 0
		lineageTag: 5908d937-ebbf-49e3-a624-7d2d8b7eafb5

		changedProperty = Name

	measure 'Total Rows Updated' = SUM('etl_execution_log'[rows_updated])
		formatString: 0
		lineageTag: 23593795-c0c3-42b1-a677-fa21db1d88e9

		changedProperty = Name

	measure 'Tables Success' =
			
			CALCULATE(
			    COUNTROWS('etl_execution_log'),
			    'etl_execution_log'[controller_id] <> 0,
			    'etl_execution_log'[status] = "Success"
			)
		formatString: 0
		lineageTag: ce5f55d7-c756-4eb2-94b4-76311a845070

		changedProperty = Name

	measure 'Avg Duration (min)' =
			
			AVERAGEX(
			    FILTER(
			        'etl_execution_log',
			        'etl_execution_log'[controller_id] = 0
			        && NOT ISBLANK('etl_execution_log'[end_time])
			    ),
			    DATEDIFF(
			        'etl_execution_log'[start_time],
			        'etl_execution_log'[end_time],
			        MINUTE
			    )
			)
		lineageTag: b9a1c526-a6b0-4ddf-9e2f-e010e855f709

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tables Cancelled' =
			
			CALCULATE(
			    COUNTROWS('etl_execution_log'),
			    'etl_execution_log'[controller_id] <> 0,
			    'etl_execution_log'[status] = "Cancelled"
			)
		formatString: 0
		lineageTag: 34816c3a-c233-470f-b46b-d0967019ccdc

		changedProperty = Name

	measure 'Pipelines Running' =
			
			CALCULATE(
			    COUNTROWS('etl_execution_log'),
			    'etl_execution_log'[controller_id] = 0,
			    'etl_execution_log'[status] = "Running"
			)
		formatString: 0
		lineageTag: cd780e5b-fc6e-460b-ad59-cb48c8e4b949

		changedProperty = Name

	measure 'Pipelines Success' =
			
			CALCULATE(
			    COUNTROWS('etl_execution_log'),
			    'etl_execution_log'[controller_id] = 0,
			    'etl_execution_log'[status] = "Success"
			)
		formatString: 0
		lineageTag: 64eb77c6-57b3-4a42-b891-440c3abb1228

		changedProperty = Name

	measure 'Pipelines Failed' =
			
			CALCULATE(
			    COUNTROWS('etl_execution_log'),
			    'etl_execution_log'[controller_id] = 0,
			    'etl_execution_log'[status] = "Failed"
			)
		formatString: 0
		lineageTag: 83fc6e9b-81dd-4aab-9cd1-b6b56e5178be

		changedProperty = Name

	measure 'Pipelines Cancellled' =
			
			CALCULATE(
			    COUNTROWS('etl_execution_log'),
			    'etl_execution_log'[controller_id] = 0,
			    'etl_execution_log'[status] = "Cancelled"
			)
		formatString: 0
		lineageTag: 563252cb-6eca-451f-8e6a-a331f2746506

		changedProperty = Name

