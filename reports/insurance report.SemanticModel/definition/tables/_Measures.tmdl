	measure 'Vehicle Count (Selected Month)' =
			
			VAR AsOf = [Selected Period End]
			VAR InsuredKeys =
			    DISTINCT (
			        SELECTCOLUMNS (
			            FILTER (
			                ADDCOLUMNS (
			                    fact_policy,
			                    "@Issued",
			                        LOOKUPVALUE (
			                            dim_date[full_date],
			                            dim_date[date_key],
			                            fact_policy[issued_date_key]
			                        ),
			                    "@Veh",
			                        LOOKUPVALUE (
			                            fact_quotation[vehicle_key],
			                            fact_quotation[quotation_id],
			                            fact_policy[quotation_id]
			                        )
			                ),
			                NOT ISBLANK ( [@Veh] )
			                    && [@Veh] <> -1
			                    && [@Issued] <= AsOf
			            ),
			            "VehicleKey", [@Veh]
			        )
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            InsuredKeys,
			            LOOKUPVALUE (
			                dim_vehicle[vehicle_brand],
			                dim_vehicle[vehicle_key],
			                [VehicleKey]
			            )
			                = MAX ( dim_vehicle[vehicle_brand] )
			        )
			    )
		formatString: 0
		lineageTag: d97c71c2-aa99-4a57-9a51-0619520bab8e

	measure 'Customers by Age Band (Selected Month)' =
			
			VAR AsOf  = [Selected Period End]
			VAR Band  = SELECTEDVALUE ( DimAgeBand[age_band] )
			VAR AgeMin =
			    SWITCH (
			        Band,
			        "25-34", 25,
			        "35-44", 35,
			        "45-54", 45,
			        "55+",   55,
			        BLANK ()
			    )
			VAR AgeMax =
			    SWITCH (
			        Band,
			        "25-34", 34,
			        "35-44", 44,
			        "45-54", 54,
			        "55+",   150,
			        BLANK ()
			    )
			RETURN
			    IF (
			        ISBLANK ( Band ),
			        BLANK (),
			        CALCULATE (
			            DISTINCTCOUNT ( dim_customer[customer_id] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_customer[customer_since_date] <= AsOf,
			            dim_customer[is_current],
			            NOT ISBLANK ( dim_customer[date_of_birth] ),
			            FILTER (
			                dim_customer,
			                VAR Age = DATEDIFF ( dim_customer[date_of_birth], AsOf, YEAR )
			                RETURN Age >= AgeMin && Age <= AgeMax
			            )
			        )
			    )
