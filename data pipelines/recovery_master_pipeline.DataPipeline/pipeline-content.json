      {
        "type": "Script",
        "typeProperties": {
          "scripts": [
            {
              "text": {
                "value": "/*\n\n  recovery_master_pipeline — assess whether to wait, start master, or recover+continue.\n\n\n\n  NO SCHEMA CHANGES — any open error on a medallion stage pipeline triggers\n\n  RECOVER_AND_CONTINUE (master batch, continue phase, or prior run).\n\n\n\n  Decision order:\n\n    1. Last master Running        → WAIT\n\n    2. Any open stage errors      → RECOVER_AND_CONTINUE (earliest stage_order)\n\n    3. Else                       → START_NEW_MASTER\n\n\n\n  Pipeline parameters:\n\n    master_pipeline_name = master_pipeline\n\n    error_status         = New\n\n*/\n\n\n\nDECLARE @master_pipeline_name VARCHAR(100) = '@{pipeline().parameters.master_pipeline_name}';\n\nDECLARE @error_status         VARCHAR(64)  = '@{pipeline().parameters.error_status}';\n\n\n\n;WITH last_master AS (\n\n    SELECT TOP 1\n\n        pipeline_run_id,\n\n        status,\n\n        start_time\n\n    FROM meta.etl_execution_log\n\n    WHERE pipeline_name = @master_pipeline_name\n\n      AND controller_id = 0\n\n    ORDER BY start_time DESC\n\n),\n\nstage_map AS (\n\n    SELECT * FROM (VALUES\n\n        ('ingest_crm_to_bronze',     'recover_ingest_crm_to_bronze',     1),\n\n        ('ingest_policy_to_bronze',  'recover_ingest_policy_to_bronze',  2),\n\n        ('bronze_to_silver',         'recover_bronze_to_silver',         3),\n\n        ('silver_to_gold',           'recover_silver_to_gold',           4)\n\n    ) AS t(main_pipeline_name, recover_pipeline_name, stage_order)\n\n),\n\nopen_errors AS (\n\n    SELECT\n\n        l.pipeline_name AS failed_pipeline_name,\n\n        l.pipeline_run_id AS failed_run_id,\n\n        m.stage_order,\n\n        m.recover_pipeline_name,\n\n        e.error_id,\n\n        e.error_timestamp\n\n    FROM meta.error_logging_table e\n\n    INNER JOIN meta.etl_execution_log l ON e.execution_id = l.log_id\n\n    INNER JOIN stage_map m ON m.main_pipeline_name = l.pipeline_name\n\n    WHERE e.status = @error_status\n\n),\n\nerror_count AS (\n\n    SELECT COUNT(DISTINCT error_id) AS open_error_count FROM open_errors\n\n),\n\nfirst_failed AS (\n\n    SELECT TOP 1\n\n        failed_pipeline_name,\n\n        failed_run_id,\n\n        stage_order AS first_failed_stage_order,\n\n        recover_pipeline_name\n\n    FROM open_errors\n\n    ORDER BY stage_order, error_timestamp DESC\n\n),\n\nassessed AS (\n\n    SELECT\n\n        CASE\n\n            WHEN EXISTS (SELECT 1 FROM last_master WHERE status = N'Running') THEN 'WAIT'\n\n            WHEN COALESCE((SELECT open_error_count FROM error_count), 0) > 0 THEN 'RECOVER_AND_CONTINUE'\n\n            ELSE 'START_NEW_MASTER'\n\n        END AS action,\n\n        (SELECT pipeline_run_id FROM last_master) AS last_master_run_id,\n\n        (SELECT status FROM last_master) AS last_master_status,\n\n        (SELECT start_time FROM last_master) AS last_master_start,\n\n        COALESCE((SELECT open_error_count FROM error_count), 0) AS open_error_count,\n\n        (SELECT failed_pipeline_name FROM first_failed) AS first_failed_pipeline_name,\n\n        (SELECT failed_run_id FROM first_failed) AS first_failed_run_id,\n\n        (SELECT recover_pipeline_name FROM first_failed) AS recover_pipeline_name,\n\n        (SELECT first_failed_stage_order FROM first_failed) AS first_failed_stage_order\n\n)\n\nSELECT * FROM assessed;\n",
                "type": "Expression"
              },
              "type": "Query"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
        "linkedService": {
          "name": "insurance_warehouse_test",
