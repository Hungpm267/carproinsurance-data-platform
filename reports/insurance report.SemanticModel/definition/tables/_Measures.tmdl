			)
		formatString: 0
		lineageTag: ea58ade7-b16d-4187-a543-7fd1665def0a

	measure 'Conversion Rate' = DIVIDE([Converted Quotations], [Total Quotation])
		formatString: 0.00%;-0.00%;0.00%
