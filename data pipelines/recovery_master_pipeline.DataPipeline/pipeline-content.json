              "text": {
                "value": "-- Script activity: Query — recovery_master_pipeline start\r\n-- Connection: Warehouse insurance_warehouse (Azure SQL Database, Entra ID)\r\n-- Requires: meta.usp_etl_log deployed\r\n\r\nEXEC meta.usp_etl_log\r\n    @action          = 'pipeline_start',\r\n    @pipeline_run_id = '@{pipeline().RunId}',\r\n    @pipeline_name   = '@{pipeline().parameters.recovery_master_pipeline_name}';\r\n",
                "type": "Expression"
              },
              "type": "Query"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
        "linkedService": {
          "name": "insurance_warehouse_test",
          "properties": {
            "type": "DataWarehouse",
            "typeProperties": {
