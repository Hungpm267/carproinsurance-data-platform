	measure 'Amount Collected Growth Display' =
			
			VAR Growth = [Amount Collected Growth]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Growth), "--",
			    Growth > 0, FORMAT(Growth, "+0.00%") & " ▲",
			    Growth < 0, FORMAT(Growth, "0.00%") & " ▼",
			    FORMAT(Growth, "0.00%") & " ▶"
			)
		lineageTag: ed755162-1104-43c2-98de-6b517c82e79d

