	measure 'Total Customers MoM %' =
			
			VAR Cur  = [Total Customers]
			VAR Prev = [Total Customers PM]
			VAR Pct  = DIVIDE ( Cur - Prev, Prev, BLANK () )
			VAR T    = 0.005
			RETURN
			    IF (
			        ISBLANK ( Prev ), BLANK (),
			        IF ( ABS ( Pct ) <= T, "▶ " & FORMAT ( 0, "0.0%" ),
			            IF ( Pct > 0, "▲ " & FORMAT ( Pct, "+0.0%;-0.0%" ),
			                "▼ " & FORMAT ( ABS ( Pct ), "0.0%" ) ) )
			    )
		lineageTag: 1141a9b8-6861-47dd-97d2-b533e5130702

