	measure 'Total Collected Premium' =
			
			CALCULATE(
			    SUM ( Fact_Payment[payment_amount] ),
			    Fact_Payment[is_successful_payment] = TRUE(),
			    USERELATIONSHIP( Dim_Date[date_key], Fact_Payment[payment_date_key] )
			)
		lineageTag: 8308c47d-eaa0-450b-93c7-af3cc3eec510

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Payment Success Rate' =
			
			VAR SuccessPayments =
			    CALCULATE(
			        SUM ( fact_payment[payment_amount] ),
			        Fact_Payment[is_successful_payment] = TRUE(),
			        USERELATIONSHIP( Dim_Date[date_key], Fact_Payment[payment_date_key] )
			    )
			VAR TotalPayments =
			    CALCULATE(
			        SUM ( fact_payment[payment_amount] ),
			        USERELATIONSHIP( Dim_Date[date_key], Fact_Payment[payment_date_key] )
			    )
			RETURN
			    DIVIDE ( SuccessPayments, TotalPayments, 0 )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 87c4eaae-1470-47a0-b72e-d0466b2a6ee3

