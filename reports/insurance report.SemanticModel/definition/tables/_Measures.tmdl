	measure 'Funnel Value' = ```
			
			VAR CurrentStage = SELECTEDVALUE('Quotation_Funnel_Stages'[Stage])
			RETURN
			SWITCH(
			    CurrentStage,
			    "All Quoted", [Total Quotation],
			    "Accepted", [Accepted Quotations],
			    "Converted", CALCULATE(COUNTROWS('Fact_Quotation'), 'Dim_Quotation_Status'[quotation_status_name] = "CONVERTED"),
			    BLANK()
			)
			
			```
