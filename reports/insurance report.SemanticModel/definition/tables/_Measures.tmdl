	measure 'Total Collected Premium MoM %' =
			
			VAR Cur  = [Total Collected Premium]
			VAR Prev = [Total Collected Premium PM]
			VAR Pct  = DIVIDE ( Cur - Prev, Prev, BLANK () )
			VAR T    = 0.005   -- flat if within ±0.5%
			RETURN
			    IF (
			        ISBLANK ( Prev ),
			        BLANK (),
			        IF (
			            ABS ( Pct ) <= T,
			            "▶ " & FORMAT ( 0, "0.0%" ),
			            IF (
			                Pct > 0,
			                "▲ " & FORMAT ( Pct, "+0.0%;-0.0%" ),
			                "▼ " & FORMAT ( ABS ( Pct ), "0.0%" )
			            )
			        )
			    )
		lineageTag: 88d9e15a-b5cc-4432-b3b3-7b040b51b36e

	measure 'Active Policies MoM %' =
			
			VAR Cur  = [Active Policies]
			VAR Prev = [Active Policies PM]
			VAR Pct  = DIVIDE ( Cur - Prev, Prev, BLANK () )
			VAR T    = 0.005
			RETURN
			    IF (
			        ISBLANK ( Prev ), BLANK (),
			        IF ( ABS ( Pct ) <= T, "▶ " & FORMAT ( 0, "0.0%" ),
			            IF ( Pct > 0, "▲ " & FORMAT ( Pct, "+0.0%;-0.0%" ),
			                "▼ " & FORMAT ( ABS ( Pct ), "0.0%" ) ) )
			    )
		lineageTag: c7ee94ef-efc5-4079-a849-27aeba39bab3

