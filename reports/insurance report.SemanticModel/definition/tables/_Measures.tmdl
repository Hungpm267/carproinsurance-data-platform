	measure 'Highest Risk Branch' =
			
			VAR _BranchRanked =
			    SUMMARIZE(
			        FILTER(dim_agent, dim_agent[is_current] = TRUE),
			        dim_agent[branch],
			        "cancel_count", CALCULATE(COUNTROWS(fact_cancellation))
			    )
			VAR _Top = TOPN(1, _BranchRanked, [cancel_count], DESC)
			RETURN
			    MAXX(_Top, dim_agent[branch])
