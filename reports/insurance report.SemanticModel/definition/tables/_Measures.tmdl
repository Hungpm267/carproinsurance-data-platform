	measure 'Payment Success Target' = 0.6
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 80a0bc03-d5ca-41c1-a711-541d82a43091

	measure 'Leading Region' =
			
			VAR _RegionSummary =
			    SUMMARIZE(
			        FILTER(dim_agent, dim_agent[is_current] = TRUE),
			        dim_agent[region],
			        "total_premium", CALCULATE(SUM(fact_policy[written_premium_amount]))
			    )
			VAR _TopRegion = TOPN(1, _RegionSummary, [total_premium], DESC)
			RETURN
			    MAXX(_TopRegion, dim_agent[region])
		lineageTag: 20a36718-c1f1-4890-a6bd-f5663f1c5a55

	measure 'Leading Region Prev' =
			
			VAR _PrevPremium =
			    CALCULATE(
			        SUM(fact_policy[written_premium_amount]),
			        DATEADD(dim_date[full_date], -1, MONTH),
			        FILTER(dim_agent, dim_agent[is_current] = TRUE)
			    )
			RETURN
			    FORMAT(_PrevPremium, "$#,0.0M")
		lineageTag: 11aeeef6-cf58-44b7-9a49-06d8af549409

	measure 'Leading Region Growth Display' =
			
			VAR _Growth = [Leading Region Growth]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_Growth), "--",
			    _Growth > 0, FORMAT(_Growth, "+0.00%") & " ▲",
