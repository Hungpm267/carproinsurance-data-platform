                "value": "-- Script activity: Query — recovery_master_pipeline end\n-- Connection: Warehouse insurance_warehouse\n--\n-- Script parameters (Settings → Script parameters):\n--\n--   Name              Type    Value (dynamic content)\n--   ----------------  ------  ------------------------------------------\n--   pipeline_status   String  @variables('pipeline_status')\n--   log_id            Int64   @variables('pipeline_log_id')\n--   pipeline_run_id   String  @pipeline().RunId\n--   pipeline_name     String  @pipeline().parameters.recovery_master_pipeline_name\n--\n-- Set variables('pipeline_status') = Failed on failure branches before this activity.\n\nIF @pipeline_status = 'Failed'\nBEGIN\n    UPDATE meta.etl_execution_log\n    SET status   = 'Failed',\n        end_time = SYSDATETIME()\n    WHERE log_id = @log_id;\n    SELECT @log_id AS log_id;\nEND\nELSE\nBEGIN\n    EXEC meta.usp_etl_log\n        @action          = 'pipeline_end',\n        @pipeline_run_id = @pipeline_run_id,\n        @pipeline_name   = @pipeline_name,\n        @log_id          = @log_id;\nEND",
