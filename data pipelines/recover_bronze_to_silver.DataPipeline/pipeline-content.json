                    "text": {
                      "value": "IF @error_id IS NULL OR LTRIM(RTRIM(@error_id)) = ''\r\n    THROW 51000, 'error_id is required.', 1;\r\n\r\nUPDATE meta.error_logging_table\r\nSET\r\n    status = 'Resolved',\r\n    updated_at = SYSUTCDATETIME()\r\nWHERE error_id = @error_id\r\n  AND status IN ('New', 'In-Progress', 'Need Manual Check');",
                      "type": "Expression"
