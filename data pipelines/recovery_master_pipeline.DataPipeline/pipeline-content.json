                  "type": "Script",
                  "typeProperties": {
                    "scripts": [
                      {
                        "text": {
                          "value": "/*\r\n  recovery_master_pipeline — main pipelines to run AFTER successful recovery.\r\n\r\n  Prerequisite: Set Variable var_first_failed_stage_order from Assess output\r\n    @activity('Assess_Last_Master').output.resultSets[0].rows[0].first_failed_stage_order\r\n\r\n  ForEach batchCount = 1.\r\n*/\r\n\r\nDECLARE @first_failed_stage_order INT = @{variables('var_first_failed_stage_order')};\r\n\r\nSELECT\r\n    main_pipeline_name,\r\n    stage_order\r\nFROM (VALUES\r\n    ('ingest_crm_to_bronze',    1),\r\n    ('ingest_policy_to_bronze', 2),\r\n    ('bronze_to_silver',        3),\r\n    ('silver_to_gold',          4)\r\n) AS stages(main_pipeline_name, stage_order)\r\nWHERE @first_failed_stage_order IS NOT NULL\r\n  AND stage_order > @first_failed_stage_order\r\nORDER BY stage_order;\r\n",
                          "type": "Expression"
                        },
                        "type": "Query"
                      }
                    ],
