	measure 'Collection Trend' = ```
			
			VAR _SelectedYear = MAX(dim_date[year_number])
			
			VAR _ChartMonthNum = MAX(TrendMonthAxis[Month Number])
			
			RETURN
			    CALCULATE(
			        [Amount Collected],
			        FILTER(
			            ALL(dim_date), 
			            VALUE(dim_date[year_number]) = _SelectedYear &&
			            dim_date[month_number] = _ChartMonthNum
			        )
			    )
			```
		lineageTag: 7cc2c2dc-e8e6-4bdc-b99e-c5a1bf30814b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Refund Trend' = ```
			
			// VAR _SelectedYear = MAX(dim_date[year_number])
			
			// VAR _ChartMonthNum = MAX(TrendMonthAxis[Month Number])
			
			// RETURN
			//     CALCULATE(
			//         [Total Refund],
			//         FILTER(
			//             ALL(dim_date), 
			//             VALUE(dim_date[year_number]) = _SelectedYear &&
			//             dim_date[month_number] = _ChartMonthNum
			//         )
			//     )
			VAR _SelectedYear = MAX(dim_date[year_number])
			VAR _ChartMonthNum = MAX(TrendMonthAxis[Month Number])
			VAR _Result =
			    CALCULATE(
			        [Total Refund],
			        FILTER(
			            ALL(dim_date),
			            VALUE(dim_date[year_number]) = _SelectedYear &&
			            dim_date[month_number] = _ChartMonthNum
			        )
			    )
			RETURN
			    _Result + 0
			```
