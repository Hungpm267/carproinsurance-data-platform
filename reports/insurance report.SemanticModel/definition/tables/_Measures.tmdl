	measure 'Conversion Rate Growth % (Overview)' = ```
			
			VAR CurrentVal = [Conversion Rate]
			VAR PrevVal = 
			    CALCULATE(
			        [Conversion Rate],
			        DATEADD('Dim_Date'[full_date], -1, MONTH)
			    )
			RETURN
			    DIVIDE(CurrentVal - PrevVal, PrevVal, BLANK())
			
			```
		lineageTag: 9418fdae-d86d-4d94-9005-0d8c494d2392

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Conversion Rate Detail Text (Overview)' = ```
			
			VAR IsSingleMonth = HASONEVALUE('Dim_Date'[month_name]) && HASONEVALUE('Dim_Date'[year_number])
			VAR Growth = [Conversion Rate Growth % (Overview)]
			VAR FormatGrowth = FORMAT(Growth, "+0.00%;-0.00%;0.00%")
			VAR Arrow = IF(Growth >= 0, " ▲", " ▼")
			RETURN
			    IF(
			        IsSingleMonth && NOT ISBLANK(Growth),
			        FormatGrowth & Arrow,
			        BLANK()
			    )
			
			```
