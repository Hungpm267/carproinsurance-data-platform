			)
		lineageTag: 9a02f3a8-5310-457e-868f-1c724574bdcd

	measure 'Leading Region Growth' =
			
			VAR _Curr =
			    SUM(fact_policy[written_premium_amount])
			VAR _Prev =
			    CALCULATE(
			        SUM(fact_policy[written_premium_amount]),
			        DATEADD(dim_date[full_date], -1, MONTH)
			    )
			RETURN DIVIDE(_Curr - _Prev, _Prev, 0)
		lineageTag: 85612bb8-e99f-4e1a-b242-2eae49cf57ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Best Conversion Region' =
			
			VAR _RegionRanked =
			    SUMMARIZE(
			        FILTER(dim_agent, dim_agent[is_current] = TRUE),
			        dim_agent[region],
			        "conv_rate", CALCULATE(
			            DIVIDE(
			                CALCULATE(
			                    COUNTROWS(fact_quotation),
			                    fact_quotation[quotation_id] IN VALUES(fact_policy[quotation_id])
			                ),
			                COUNTROWS(fact_quotation),
			                0
			            )
			        )
			    )
			VAR _Top = TOPN(1, _RegionRanked, [conv_rate], DESC)
			RETURN
			    MAXX(_Top, dim_agent[region])
		lineageTag: 142fc090-6cc7-4eb0-a687-a7f1b6c17d34

	measure 'Best Conversion Region Prev' =
			
			VAR _Prev =
			    CALCULATE(
			        DIVIDE(
			            CALCULATE(
			                COUNTROWS(fact_quotation),
			                fact_quotation[quotation_id] IN VALUES(fact_policy[quotation_id])
			            ),
			            COUNTROWS(fact_quotation),
			            0
			        ),
			        DATEADD(dim_date[full_date], -1, MONTH)
			    )
			RETURN
			    FORMAT(_Prev, "0.00%")
		lineageTag: 6e053f60-a500-45e4-9b2b-a49b6321e13b

	measure 'Best Conversion Region Growth' =
			
			VAR _Curr =
			    DIVIDE(
			        CALCULATE(
			            COUNTROWS(fact_quotation),
			            fact_quotation[quotation_id] IN VALUES(fact_policy[quotation_id])
			        ),
			        COUNTROWS(fact_quotation),
			        0
			    )
			VAR _Prev =
			    CALCULATE(
			        DIVIDE(
			            CALCULATE(
			                COUNTROWS(fact_quotation),
			                fact_quotation[quotation_id] IN VALUES(fact_policy[quotation_id])
			            ),
			            COUNTROWS(fact_quotation),
			            0
			        ),
			        DATEADD(dim_date[full_date], -1, MONTH)
			    )
			RETURN DIVIDE(_Curr - _Prev, _Prev, 0)
		lineageTag: 595e6dd7-1596-49a0-bf8e-1f425a624f18

		annotation PBI_FormatHint = {"isGeneralNumber":true}

