                            "value": "DECLARE @calculated_watermark_to NVARCHAR(50) = 'NULL';\nIF @load_type != 'FULL' AND @watermark_column IS NOT NULL\nBEGIN\n    DECLARE @sql NVARCHAR(MAX);\n    DECLARE @param_definition NVARCHAR(500) = N'@res NVARCHAR(50) OUTPUT';\n    \n    SET @sql = N'SELECT @res = CAST(MAX([' + REPLACE(@watermark_column, '''', '''''') + ']) AS NVARCHAR(50)) FROM [' + REPLACE(@target_schema, '''', '''''') + '].[' + REPLACE(@target_table, '''', '''''') + ']';\n    \n    EXEC sp_executesql @sql, @param_definition, @res = @calculated_watermark_to OUTPUT;\nEND\n-- Gọi Procedure log với các tham số sạch\nEXEC meta.usp_etl_log \n    @action = 'entity_success',\n    @pipeline_run_id = @pipeline_run_id,\n    @pipeline_name = @pipeline_name,\n    @controller_id = @controller_id,\n    @log_id = @log_id,\n    @load_type = @load_type,\n    @rows_read = @rows_read,\n    @rows_inserted = @rows_read, \n    @watermark_from = @watermark_from,\n    @watermark_to = @calculated_watermark_to;",
                            "type": "Expression"
                          },
